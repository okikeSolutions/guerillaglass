{
  "name": "@guerillaglass/desktop-electrobun",
  "version": "1.0.0",
  "description": "Guerillaglass desktop shell built with Electrobun + React + Tailwind",
  "type": "module",
  "scripts": {
    "dev": "bun run build && electrobun dev",
    "dev:open": "bun run build && open build/dev-macos-arm64/Guerillaglass-dev.app",
    "dev:hmr": "concurrently \"bun run hmr\" \"bun run dev\"",
    "hmr": "vite --port 5173",
    "build": "bun run i18n:compile && vite build && electrobun build",
    "build:prod": "bun run i18n:compile && vite build && electrobun build --channel prod",
    "typecheck": "bun run i18n:compile && tsc --noEmit -p tsconfig.json",
    "test": "bun run test:bun && bun run test:vitest",
    "test:coverage": "bun run i18n:compile && bun test --coverage",
    "test:ui": "playwright test -c playwright.config.ts",
    "test:ui:headed": "playwright test -c playwright.config.ts --headed",
    "test:ui:install": "playwright install chromium",
    "start": "bun run dev",
    "test:bun": "bun run i18n:compile && bun test",
    "test:vitest": "bun run i18n:compile && vitest -c vitest.config.ts",
    "i18n:compile": "cd ../.. && bun run i18n:compile:desktop"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@effect/platform-bun": "4.0.0-beta.78",
    "@fontsource-variable/inter": "^5.2.8",
    "@guerillaglass/engine": "workspace:*",
    "@guerillaglass/review-protocol": "workspace:*",
    "@guerillaglass/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-pacer": "^0.22.1",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.15",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.40.0",
    "date-fns": "^4.4.0",
    "effect": "4.0.0-beta.78",
    "electrobun": "1.18.1",
    "lucide-react": "^1.17.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^4.11.2",
    "shadcn": "^4.10.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.78",
    "@playwright/test": "^1.60.0",
    "@types/bun": "latest",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
