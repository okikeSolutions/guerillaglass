{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "ES2021.Promise", "ES2021.String", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["bun", "node", "vite/client"],
    "paths": {
      "@/*": ["./src/mainview/*"],
      "@lib/*": ["./src/mainview/lib/*"],
      "@shared/*": ["./src/shared/*"],
      "@studio/*": ["./src/mainview/app/studio/*"],
      "electrobun": ["./.hutch/devkit/api/sdks/main/index.ts"],
      "electrobun/bun": ["./.hutch/devkit/api/sdks/main/index.ts"],
      "electrobun/view": ["./.hutch/devkit/api/browser/index.ts"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "@effect/platform-node-shared/NodeCrypto",
          "@effect/platform-node/NodeHttpClient",
          "@effect/platform-node/NodeHttpServer",
          "@effect/platform-node/NodeRuntime",
          "@effect/platform-node/NodeServices",
          "@effect/vitest",
          "effect/FileSystem",
          "effect/Logger",
          "effect/Path",
          "effect/crypto/Digest",
          "effect/crypto/SecureRandom",
          "effect/devtools/DevTools",
          "effect/http-api/HttpApi",
          "effect/http-api/HttpApiClient",
          "effect/http-api/HttpApiEndpoint",
          "effect/http-api/HttpApiGroup",
          "effect/http-api/HttpApiMiddleware",
          "effect/http-api/HttpApiSchema",
          "effect/http-api/HttpApiSecurity",
          "effect/http-api/OpenApi",
          "effect/http/Headers",
          "effect/http/HttpClient",
          "effect/http/HttpClientRequest",
          "effect/http/HttpClientResponse",
          "effect/http/HttpPlatform",
          "effect/http/HttpRouter",
          "effect/http/HttpServer",
          "effect/http/HttpServerRequest",
          "effect/http/HttpServerResponse",
          "effect/net/NetAddress",
          "effect/persistence/RateLimiter",
          "effect/process/ChildProcess",
          "effect/process/ChildProcessSpawner"
        ]
      }
    ]
  },
  "include": ["src", "tests", "scripts", "*.config.ts"],
  "exclude": ["node_modules", "dist", "build", "tests/ui"],
  "$schema": "../../node_modules/@effect/tsgo/schema.json"
}
