{
  "name": "@guerillaglass/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "bun run i18n:compile && vite build",
    "typecheck": "bun run i18n:compile && bun run typecheck:ci",
    "typecheck:ci": "tsc --noEmit",
    "preview": "vite preview",
    "test": "bun run i18n:compile && bun run test:ci",
    "test:ci": "vitest run",
    "generate:auth": "SITE_URL=http://localhost:3000 npx @better-auth/cli generate -y --config convex/betterAuth/auth.ts --output convex/betterAuth/generatedSchema.ts",
    "i18n:compile": "cd ../.. && bun run i18n:compile:web"
  },
  "dependencies": {
    "@convex-dev/better-auth": "^0.12.5",
    "@convex-dev/react-query": "^0.1.0",
    "@guerillaglass/ui": "workspace:*",
    "@react-three/fiber": "^9.6.1",
    "@shadergradient/react": "^2.4.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.9",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/react-start": "^1.168.32",
    "@tanstack/router-plugin": "^1.168.23",
    "better-auth": "1.6.25",
    "camera-controls": "^3.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.42.3",
    "lucide-react": "^1.26.0",
    "motion": "^12.42.2",
    "nitro": "latest",
    "radix-ui": "^1.6.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "^0.8.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.0",
    "shadcn": "^4.14.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
