{
  "name": "@guerillaglass/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "bun run i18n:compile && vite build",
    "typecheck": "bun run i18n:compile && bun run typecheck:ci",
    "typecheck:ci": "tsc --noEmit",
    "preview": "vite preview",
    "test": "bun run i18n:compile && bun run test:ci",
    "test:ci": "vitest run",
    "generate:auth": "SITE_URL=http://localhost:3000 bunx auth@1.7.18 generate -y --config convex/betterAuth/auth.ts --output convex/betterAuth/generatedSchema.ts && bun -e 'const path = \"convex/betterAuth/generatedSchema.ts\"; const text = await Bun.file(path).text(); await Bun.write(path, text.replace(/npx auth generate --output .*/, \"bun run --cwd apps/web generate:auth\"));'",
    "i18n:compile": "cd ../.. && bun run i18n:compile:web"
  },
  "dependencies": {
    "@convex-dev/better-auth": "^0.13.0",
    "@convex-dev/react-query": "^0.1.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@guerillaglass/ui": "workspace:*",
    "@react-three/fiber": "^9.8.2",
    "@shadergradient/react": "^2.4.20",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.3",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/react-start": "^1.169.5",
    "@tanstack/router-plugin": "^1.169.0",
    "better-auth": "1.7.18",
    "camera-controls": "^3.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.49.0",
    "effect": "4.1.2",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "nitro": "^3.0.261103-rc",
    "radix-ui": "^1.8.1",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "^0.8.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
