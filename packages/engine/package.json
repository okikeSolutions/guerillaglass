    "./client/config/paths": "./src/client/config/paths.ts",
    "./client/config/targets": "./src/client/config/targets.ts",
    "./client/errors/clientErrors": "./src/client/errors/clientErrors.ts",
    "./client/rpc/protocol": "./src/client/rpc/protocol.ts",
    "./protocol/domains/agent": "./src/protocol/domains/agent.ts",
    "./protocol/domains/capture": "./src/protocol/domains/capture.ts",
    "./protocol/domains/export": "./src/protocol/domains/export.ts",
    "./protocol/domains/permissions": "./src/protocol/domains/permissions.ts",
    "./protocol/domains/project": "./src/protocol/domains/project.ts",
    "./protocol/domains/recording": "./src/protocol/domains/recording.ts",
    "./protocol/domains/sources": "./src/protocol/domains/sources.ts",
    "./protocol/domains/system": "./src/protocol/domains/system.ts",
    "./protocol/domains/timeline": "./src/protocol/domains/timeline.ts",
    "./protocol/rpc/errors": "./src/protocol/rpc/errors.ts",
    "./protocol/rpc/group": "./src/protocol/rpc/group.ts",
    "./protocol/schema-primitives": "./src/protocol/schema-primitives.ts",
